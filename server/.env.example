# 복사해서 .env로 쓴다: cp .env.example .env  (.env는 커밋하지 않는다)
# docker compose로 켜면 아래 값은 docker-compose.yml이 넣어 준다. 내 컴퓨터에서 uvicorn으로 켤 때만 쓴다.

# DB 주소 (기본값: docker compose의 db 컨테이너에 내 컴퓨터에서 붙는 주소)
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/settle

# 허용할 화면 주소 (쉼표로 여러 개)
CORS_ORIGINS=http://localhost:3000

# 영수증 사진 저장 폴더 (Docker에서는 볼륨 /data/receipts)
RECEIPT_STORAGE_PATH=./data/receipts

# 서버가 켜질 때 DB 테이블을 최신으로 올릴지 (alembic upgrade head)
AUTO_MIGRATE=true
