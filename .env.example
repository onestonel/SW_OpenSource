# 복사해서 .env로 쓴다:  copy .env.example .env  (Mac/Linux: cp .env.example .env)
# .env는 커밋하지 않는다. 값을 안 바꾸면 docker-compose.yml의 기본값을 쓴다.

POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=settle

# 자연어 해석기: stub(모델 없이 간단한 규칙으로 흉내) / llamacpp(llama.cpp · EXAONE, --profile llm 과 같이)
NL_PROVIDER=stub

# 큰 모델로 넘기기 (선택): 작은 모델 답이 서버 검사에서 걸리거나 llm이 꺼져 있을 때만 GPT에 다시 묻는다.
# 키는 이 파일(.env)에만 넣고 절대 커밋하지 마세요. 비우면 넘기지 않습니다.
OPENAI_API_KEY=
NL_FALLBACK_MODEL=gpt-4.1-mini

# 영수증 사진 자동 인식: stub(고정 답) / remote(PaddleOCR 컨테이너, --profile ocr 과 같이)
OCR_ENGINE=stub

# 화면을 서버 없이 목(mock) 데이터로 보려면 true
VITE_USE_MOCK=false
